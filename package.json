{
  "name": "amas-plant-corner",
  "version": "1.0.0",
  "description": "Ama's plant shop.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "check": "npm run lint && npm run format:check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,css,json,md,yml}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/David-Sedzro/the-plant-corner.git"
  },
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/David-Sedzro/the-plant-corner/issues"
  },
  "homepage": "https://github.com/David-Sedzro/the-plant-corner#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "3.10.1",
    "vite": "^8.3.8"
  }
}
